     "expr": "idrac_events_log_entry",
     "format": "table",
     "instant": true,
     "refId": "A"
    }
   ],
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "Value": true,
       "__name__": true,
       "job": true,
       "endpoint": true,
       "namespace": true,
       "pod": true,
       "service": true,
       "container": true,
       "instance": true
      },
      "indexByName": {
       "server": 0,
       "severity": 1,
       "id": 2,
       "message": 3
      }
     }
    }
   ],
