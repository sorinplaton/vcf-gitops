   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (server) (idrac_system_health != bool 0) * 0 + max by (server) (idrac_system_health)",
     "legendFormat": "{{server}}",
     "refId": "A",
     "instant": true
    }
   ]
  },
