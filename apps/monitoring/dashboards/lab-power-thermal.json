    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "celsius",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 92
       },
       {
        "color": "red",
        "value": 101
       }
      ]
     }
    },
