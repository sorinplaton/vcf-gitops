  {
   "type": "table",
   "title": "iDRAC lifecycle log: warnings and above (last 7 days)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 28,
    "w": 24,
    "h": 9
   },
   "options": {
    "showHeader": true,
    "sortBy": [
     {
      "displayName": "severity",
      "desc": true
     }
    ]
