{
 "uid": "lab-power-thermal",
 "title": "Lab: Dell power and thermal (iDRAC)",
 "tags": [
  "lab",
  "dell",
  "idrac"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "graphTooltip": 1,
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "refresh": "1m",
 "panels": [
  {
   "type": "stat",
   "title": "Power now",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "watt",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 550
       },
       {
        "color": "red",
        "value": 700
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "value_and_name"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (server) (idrac_power_control_consumed_watts)",
     "legendFormat": "{{server}}",
     "refId": "A",
     "instant": true
    }
   ]
  },
  {
   "type": "stat",
   "title": "Hottest CPU",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
