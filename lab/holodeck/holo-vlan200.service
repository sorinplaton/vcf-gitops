# Transcribed from the blog; replace with the copy from the router.
# /etc/systemd/system/holo-vlan200.service on the holorouter.
[Unit]
Description=VLAN 200 gateway (10.200.200.1/24) and DNS redirect for the holo-east external block
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/bash /usr/local/bin/holo-vlan200.sh

[Install]
WantedBy=multi-user.target
